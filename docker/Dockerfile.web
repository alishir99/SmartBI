# Build context is repo root (not web/), so this Dockerfile can live under docker/ with
# Dockerfile.python instead of inside the directory it builds.

FROM node:24-slim AS build

WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./

# Build arg, not env var: Vite inlines every VITE_* into the bundle at build time, so
# setting this at run time on a static image does nothing.
ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# This stage carries only the built assets - no node, no source. Unprivileged nginx runs
# as uid 101 on 8080, so nothing here needs root to bind a low port.
FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

# Hash-based router: every URL is `/` to the server, so no SPA fallback is needed.
EXPOSE 8080
