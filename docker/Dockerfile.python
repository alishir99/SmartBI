FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependencies before source, so editing a route doesn't invalidate the pip layer. Deps are
# read straight out of pyproject.toml, not duplicated into a requirements.txt.
COPY pyproject.toml ./
RUN python -c "import tomllib; print('\n'.join(tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']))" > /tmp/requirements.txt \
    && pip install --upgrade pip \
    && pip install -r /tmp/requirements.txt

COPY . .
RUN pip install --no-deps .

# uid 1000: bind-mounted ./logs and ./data keep the host's ownership, and 1000 is the first
# user on a Linux desktop. Mismatched uid on the host: chown those dirs or add `user: root`.
RUN useradd --uid 1000 --create-home app && chown -R app:app /app
USER app
