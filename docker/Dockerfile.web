FROM node:24-slim

WORKDIR /app

# Build context is the repo root (not web/) so this Dockerfile does not have to live inside
# the directory it builds — keeps all three Dockerfiles together under docker/.
COPY web/package.json web/package-lock.json* ./
RUN npm install

COPY web/ ./

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
