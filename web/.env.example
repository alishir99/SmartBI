# Serve the fixtures in src/lib/mocks.ts instead of calling the API.
# The real fetch path is the default; set this to true only for design/demo work.
VITE_USE_MOCKS=false

# Leave empty to use the Vite dev proxy (/api -> VITE_PROXY_TARGET).
VITE_API_BASE_URL=

# Where the dev proxy forwards /api during `npm run dev`.
VITE_PROXY_TARGET=http://localhost:8000
