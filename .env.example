# Copy to .env before `docker compose up`.

# --- Posture ---
# `dev` permits the in-repo secrets below. Anything else makes the API and the MCP server
# refuse to start until JWT_SECRET, INTERNAL_TOKEN, POSTGRES_PASSWORD and APP_DB_PASSWORD
# hold real values â€” because every default in this file is published in the repository, and
# an unconfigured deployment should fail loudly rather than run on them.
SOLVIGO_ENV=dev

# --- Postgres ---
POSTGRES_USER=solvigo
POSTGRES_PASSWORD=solvigo
POSTGRES_DB=solvigo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Read-only role the MCP server connects as (created by db/sql/04_rls.sql)
APP_DB_USER=app_readonly
APP_DB_PASSWORD=app_readonly

# --- MCP server ---
MCP_HOST=0.0.0.0
MCP_PORT=8081
MCP_URL=http://mcp:8081/mcp
# Shared secret proving a caller of the tool surface is the API. Defence in depth: the MCP
# server is not published to the host by default (see docker-compose.demo.yml).
INTERNAL_TOKEN=dev-internal-token

# --- API ---
API_PORT=8000
JWT_SECRET=dev-only-change-me-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30

# --- Mail (password reset) ---
# `log` writes the reset link to the application log and sends nothing - which is what the
# demo wants, and what makes the flow exercisable without an SMTP account
# (`docker compose logs api | grep mail.logged`). Set `smtp` and the four values below to
# send for real.
MAIL_BACKEND=log
MAIL_FROM=no-reply@solvigo.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Minimum password length, enforced by the API and shown by the reset form. Length is the
# control that matters; composition rules push people towards weaker, guessable passwords.
PASSWORD_MIN_LENGTH=8
# How long a reset link stays valid. Single use is enforced separately - redeeming one
# changes the password hash, which is what the link is signed against.
PASSWORD_RESET_TTL_MINUTES=60

# --- Market: currency, locale, language ---
# Nothing in the code assumes Sweden or kronor. These three say what the warehouse holds and
# how to present it; point them at another market and every amount, axis label, month name and
# card title follows. APP_CURRENCY must be the same for the API and the MCP server: it is one
# warehouse, and two answers to "what currency is this" is a mislabelled number.
#   APP_CURRENCY=EUR / APP_LOCALE=de-DE / APP_LANGUAGE=en  is a valid combination.
# One currency per deployment. A warehouse holding several is future work: the tools would
# have to return the currency per row and the chart axis would need a conversion date, which
# is a data model question rather than a formatting one.
APP_CURRENCY=SEK
APP_LOCALE=sv-SE
# Default answer language. The UI has a switcher and sends its choice per request, so this is
# only what a client that never asks gets. Supported: sv, en.
APP_LANGUAGE=sv
# False means the amounts exclude VAT, which is what the source chip and the card subtitle say.
PRICES_INCLUDE_VAT=false

# --- LLM ---
# Driven through the Anthropic SDK regardless of provider (decision D1). Point these at
# api.anthropic.com + claude-opus-5 to run on real Claude; nothing else changes.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-pro

# --- Web ---
VITE_API_BASE_URL=http://localhost:8000

# --- Logging ---
# `json` for anything shipped and for the file; `text` is easier to read on a local run.
LOG_LEVEL=INFO
LOG_FORMAT=json
# Empty = stdout only. Compose sets this to /app/logs/api.jsonl, mounted at ./logs.
# The file rotates at midnight UTC into api-YYYY-MM-DD.jsonl and keeps LOG_RETENTION_DAYS
# of them. `.jsonl` because the contents are JSON Lines, not free text â€” jq and every log
# shipper read it directly.
LOG_FILE=
LOG_RETENTION_DAYS=14
# Puts question text, rejected figures and tool argument values back in. Local debugging
# only â€” see README, "Vad som medvetet inte loggas".
LOG_SENSITIVE=false
