# Copy to .env before `docker compose up`.

# --- Posture ---
# `dev` permits the in-repo secrets below. Anything else makes the API and the MCP server
# refuse to start until JWT_SECRET, INTERNAL_TOKEN, POSTGRES_PASSWORD and APP_DB_PASSWORD
# hold real values — because every default in this file is published in the repository, and
# an unconfigured deployment should fail loudly rather than run on them.
SOLVIGO_ENV=dev

# --- Postgres ---
POSTGRES_USER=solvigo
POSTGRES_PASSWORD=solvigo
POSTGRES_DB=solvigo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Read-only role the MCP server connects as (created by db/sql/04_rls.sql)
APP_DB_USER=app_readonly
APP_DB_PASSWORD=app_readonly

# --- MCP server ---
MCP_HOST=0.0.0.0
MCP_PORT=8081
MCP_URL=http://mcp:8081/mcp
# Shared secret proving a caller of the tool surface is the API. Defence in depth: the MCP
# server is not published to the host by default (see docker-compose.demo.yml).
INTERNAL_TOKEN=dev-internal-token

# --- API ---
API_PORT=8000
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30

# --- LLM ---
# Driven through the Anthropic SDK regardless of provider (decision D1). Point these at
# api.anthropic.com + claude-opus-5 to run on real Claude; nothing else changes.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-pro

# --- Web ---
VITE_API_BASE_URL=http://localhost:8000

# --- Logging ---
# `json` for anything shipped and for the file; `text` is easier to read on a local run.
LOG_LEVEL=INFO
LOG_FORMAT=json
# Empty = stdout only. Compose sets this to /app/logs/api.jsonl, mounted at ./logs.
# The file rotates at midnight UTC into api-YYYY-MM-DD.jsonl and keeps LOG_RETENTION_DAYS
# of them. `.jsonl` because the contents are JSON Lines, not free text — jq and every log
# shipper read it directly.
LOG_FILE=
LOG_RETENTION_DAYS=14
# Puts question text, rejected figures and tool argument values back in. Local debugging
# only — see README, "Vad som medvetet inte loggas".
LOG_SENSITIVE=false
